# Python bytecode (ignores __pycache__ folders everywhere)
__pycache__/
*.py[cod]
*$py.class

# C/C++ compiled outputs (common in DeepStream custom plugins)
*.o
*.so
*.out

# IDEs and editors
.vscode/
.idea/
.DS_Store

# Local configuration / environment files
.env

# Large generated action-recognition model artifacts (etlt + built engine)
models/

# Encoded pipeline output
output*.mp4