# ---------------------------------------------------------------------------
# Dockerfile.example
#
# Minimal example showing how to bake the patched action-recognition
# custom-sequence-preprocess library into a DeepStream 8.0 container image.
#
# The build/install logic has been factored into docker/build_sequence_lib.sh so
# it can also be re-run manually inside a running container (for dev iteration)
# without rebuilding the whole image.
#
# Build:
#   docker build -f docker/Dockerfile.example -t deepstream-action:latest .
# ---------------------------------------------------------------------------

ARG BASE_IMAGE=nvcr.io/nvidia/deepstream:8.0-triton-multiarch

FROM ${BASE_IMAGE}

# 1) Copy the patched custom-sequence-preprocess source into the image.
#    The script resolves its source dir relative to the image's /opt/ds-build.
COPY custom_sequence_preprocess/ /opt/ds-build/custom_sequence_preprocess/
COPY docker/build_sequence_lib.sh /opt/ds-build/docker/build_sequence_lib.sh

# 2) Build and install the library (CUDA_VER is fixed for this image).
RUN chmod +x /opt/ds-build/docker/build_sequence_lib.sh \
    && DS_VERSION=8.0 CUDA_VER=12.8 /opt/ds-build/docker/build_sequence_lib.sh

# 3) The .so is now in place; drop the staging source to keep the image lean.
RUN rm -rf /opt/ds-build

# NOTE: If you re-run the script in a fresh container for dev testing, copy the
# source to /opt/ds-build and run build_sequence_lib.sh there, exactly as above.
